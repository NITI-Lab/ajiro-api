meta {
  name: Create user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: bearer
}

headers {
  X-Trace: abc
  ~X-Disabled: nope
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "email": "{{email}}",
    "profile": {
      "name": "Carol",
      "tags": ["a", "b"]
    }
  }
}

vars:pre-request {
  email: carol@example.com
}

assert {
  res.status: eq 201
  res.body.id: isNumber
}

script:post-response {
  console.log(res.body);
}

docs {
  Creates a user.
}
