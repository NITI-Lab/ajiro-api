    "claude-code", "claude", "codex", "mcp", "mcp-server", "ai-agents", "coding-agent", "llm",
    "nextjs", "hono", "fastapi", "express", "golang", "yaml", "cli"
  ],
  "author": { "name": "NITI", "url": "https://nititech.jp/" },
  "license": "MIT",
  "homepage": "https://nititech.jp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niti-lab/ajiro-api.git",
    "directory": "npm/ajiro-api"
  },
  "bugs": { "url": "https://github.com/niti-lab/ajiro-api/issues" },
  "bin": { "ajiro-api": "bin/ajiro-api.js" },
  "files": ["bin/", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "optionalDependencies": {
    "@niti-lab/ajiro-api-linux-x64": "0.2.5",
    "@niti-lab/ajiro-api-linux-arm64": "0.2.5",
    "@niti-lab/ajiro-api-darwin-x64": "0.2.5",
    "@niti-lab/ajiro-api-darwin-arm64": "0.2.5",
    "@niti-lab/ajiro-api-win32-x64": "0.2.5"
  }
